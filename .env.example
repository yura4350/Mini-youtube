# Intelligence service (real AI summary) environment template
# Copy this file to `.env` and fill with your own values.

OPENAI_BASE_URL=https://litellm.oit.duke.edu/v1
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=GPT 4.1
OPENAI_SUMMARY_ENABLED=true
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=220

# LOCUST environment variables - for load testing
LOCUST_AUTH_EMAIL=your_locust_auth_email@example.com
LOCUST_AUTH_PASSWORD=your_locust_auth_password
LOCUST_USER_ID=your_locust_user_id