import os

import jwt
import pytest
from fastapi.testclient import TestClient
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker
from sqlalchemy.pool import StaticPool

os.environ["DATABASE_URL"] = "sqlite://"
os.environ["SECRET_KEY"] = "test-secret-key"
os.environ["ALGORITHM"] = "HS256"

from src.user_prefs_and_accounts_service.main import (
    ALGORITHM,
    Base,
    SECRET_KEY,
    User,
    app,
    create_password_reset_token,
    get_db,
    get_pwd_hash,
    send_reset_email,
)

engine = create_engine(
    "sqlite://",
    connect_args={"check_same_thread": False},
    poolclass=StaticPool,
)
TestingSessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=engine)


def override_get_db():
    db = TestingSessionLocal()
    try:
        yield db
    finally:
        db.close()


@pytest.fixture(autouse=True)
def setup_db():
    Base.metadata.create_all(bind=engine)
    yield
    Base.metadata.drop_all(bind=engine)


@pytest.fixture
def client():
    app.dependency_overrides.clear()
    app.dependency_overrides[get_db] = override_get_db
    with TestClient(app) as c:
        yield c
    app.dependency_overrides.clear()


def seed_user(
    *,
    name: str,
    email: str,
    role: str,
    password: str,
    is_active: bool = True,
):
    db = TestingSessionLocal()
    try:
        user = User(
            name=name,
            email=email,
            role=role,
            hashed_pwd=get_pwd_hash(password),
            is_active=is_active,
        )
        db.add(user)
        db.commit()
        db.refresh(user)
        return user
    finally:
        db.close()


def test_forgot_password_existing_active_user_triggers_email(client, monkeypatch):
    email = "active@example.com"
    seed_user(name="Active", email=email, role="user", password="Oldpass123", is_active=True)

    sent = {"calls": []}

    async def fake_send_reset_email(recipient_email: str, token: str):
        sent["calls"].append((recipient_email, token))

    # Patch the symbol used by the endpoint
    monkeypatch.setattr(
        "src.user_prefs_and_accounts_service.main.send_reset_email",
        fake_send_reset_email,
    )

    resp = client.post("/auth/forgot-password", json={"email": email})

    assert resp.status_code == 200
    assert resp.json() == {"message": "If that email is in our system, a reset link has been sent."}
    assert len(sent["calls"]) == 1
    assert sent["calls"][0][0] == email

    token = sent["calls"][0][1]
    payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
    assert payload["sub"] == email
    assert payload["type"] == "reset"


def test_forgot_password_unknown_email_returns_same_message_and_no_send(client, monkeypatch):
    sent = {"calls": 0}

    async def fake_send_reset_email(recipient_email: str, token: str):
        sent["calls"] += 1

    monkeypatch.setattr(
        "src.user_prefs_and_accounts_service.main.send_reset_email",
        fake_send_reset_email,
    )

    resp = client.post("/auth/forgot-password", json={"email": "unknown@example.com"})

    assert resp.status_code == 200
    assert resp.json() == {"message": "If that email is in our system, a reset link has been sent."}
    assert sent["calls"] == 0

def test_reset_password_valid_token_updates_password_and_allows_login(client):
    email = "resetme@example.com"
    old_password = "Oldpass123"
    new_password = "Newpass123"
    seed_user(name="Reset Me", email=email, role="user", password=old_password, is_active=True)

    token = create_password_reset_token(email)

    reset_resp = client.post(
        "/auth/reset-password",
        json={"token": token, "new_password": new_password},
    )
    assert reset_resp.status_code == 200
    assert reset_resp.json() == {"message": "Password has been reset successfully"}

    # old password should fail
    old_login = client.post("/auth/login/", data={"username": email, "password": old_password})
    assert old_login.status_code == 401

    # new password should work
    new_login = client.post("/auth/login/", data={"username": email, "password": new_password})
    assert new_login.status_code == 200
    assert "access_token" in new_login.json()


def test_reset_password_invalid_token_returns_400(client):
    resp = client.post(
        "/auth/reset-password",
        json={"token": "not-a-valid-token", "new_password": "Newpass123"},
    )
    assert resp.status_code == 400
    assert resp.json()["detail"] == "Invalid or expired reset token"